# Spring Boot Environment Configuration Template (.env.example)
SERVER_PORT=8080
PORT=8080

# Supabase PostgreSQL Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-supabase-db-password

# Alternative raw connection URL for Render
DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-supabase-db-password

# JWT Security (Must be at least 256 bits / 64 hex characters)
JWT_SECRET=your-secure-256-bit-hex-secret-key-min-64-characters
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# CORS Allowed Origin
FRONTEND_URL=https://expense-tracker-pro-sigma-sage.vercel.app
